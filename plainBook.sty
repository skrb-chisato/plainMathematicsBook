% Template name: Plain mathematics book
% Version: 0.1.1
% Author: Chisato

% Do not change the command order or remove spaces to avoid errors.

% Environment

\NeedsTeXFormat{LaTeX2e} % Specifie the required LaTeX format.

% Metadata

\ProvidesPackage{plainBook} % Provide the template name.

% Package

\RequirePackage[a4paper, includeheadfoot, top=20mm, bottom=20mm, left=24mm, right=24mm]{geometry} % Customize page layout, including paper size and margins.
\RequirePackage{setspace} % Allow adjustment of line spacing.
% \RequirePackage{ctex} % Uncomment this line if Chinese typesetting is required.
\RequirePackage{mathpazo} % Set the font to Palatino.
\RequirePackage{amsmath} % Enhance math typesetting with additional environments.
\RequirePackage{amssymb} % Provide extra mathematical symbols.
\RequirePackage{amsthm} % Introduce theorem-like environments (theorems, proofs, etc.).
\RequirePackage{mathtools} % Provide advanced tools and enhancements for mathematical typesetting.
\RequirePackage{pifont} % Provide standard PostScript Zapf Dingbats.
\RequirePackage{graphicx} % Enable inclusion of external images.
\RequirePackage{makeidx} % Facilitate the creation of an index.
\RequirePackage{hyperref} % Enable hyperlinks within the document.
\RequirePackage{tikz} % Enable creating graphics, diagrams, and illustrations.
\RequirePackage{tikz-cd} % Enable creating commutative diagrams.
\RequirePackage{appendix} % Provide chapter-level appendices.
\RequirePackage{enumitem} % Enable advanced customization of list environments.
\RequirePackage{booktabs} % Enable advanced customization of table rules and spacing.
\RequirePackage{longtable} % Allow tables to span across multiple pages.

% Theorem style

\theoremstyle{definition}
    \newtheorem{definition}{Definition}[section] % Define a "definition" theorem style for definitions.

\theoremstyle{plain}
    \newtheorem{axiom}{Axiom}[section] % Define a "plain" theorem style for axioms.
    \newtheorem{theorem}{Theorem}[section] % Define a "plain" theorem style for theorems.
    \newtheorem{corollary}[theorem]{Corollary} % Define a corollary style linked to theorems.
    \newtheorem{lemma}[theorem]{Lemma} % Define a lemma style linked to theorems.
    \newtheorem{proposition}[theorem]{Proposition} % Define a proposition style linked to theorems.

\theoremstyle{remark}
    \newtheorem{example}{Example}[section] % Define a "remark" theorem style for examples.
    \newtheorem{exercise}{Exercise}[section] % Define a "remark" theorem style for exercises.
    \newtheorem{remark}{Remark}[section] % Define a "remark" theorem style for remarks.

% Index

\makeindex % Enable index creation.
